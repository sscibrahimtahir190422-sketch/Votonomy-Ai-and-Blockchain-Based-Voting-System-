# Email Configuration for Password Reset & Admin Notifications
MAIL_PASSWORD=your_gmail_app_password_here

# Flask Configuration
SECRET_KEY=your_secret_key_here

# Database (optional, defaults to SQLite)
# DATABASE_URL=sqlite:///votonomy.db

# Blockchain Configuration (optional)
# BLOCKCHAIN_RPC_URL=https://api.devnet.solana.com
# ADMIN_KEYPAIR_PATH=wallets/admin_keypair.json

# Note: 
# 1. For MAIL_PASSWORD, generate an App Password from Google Account:
#    - Go to myaccount.google.com
#    - Enable 2-Step Verification
#    - Create an App Password for Gmail
# 2. Keep your .env file secret and do NOT commit it to version control
# 3. Copy this file to .env and fill in your actual values
